---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import PostList from "../components/PostList.astro";
import { loadEssays, loadEssaysFile, loadWriting } from "../lib/posts";

const writing = loadWriting();
const essaysFile = loadEssaysFile();
const posts = loadEssays();
---

<Base title="Writing — Nye Warburton" description={writing.intro}>
  <main id="main" class="page">
    <header class="page-head">
      <PageHead title={writing.heading} />
      <p class="draft-label">{essaysFile.label}</p>
      <p class="lead">{writing.intro}</p>
      <p class="subscribe">
        <a href={writing.subscribeHref} rel="noopener noreferrer">{writing.subscribeLabel}</a>
        <span class="sep">·</span>
        <a class="quiet" href={writing.secondaryHref} rel="noopener noreferrer">{writing.secondaryLabel}</a>
      </p>
    </header>

    {
      posts.length ? (
        <div class="essay-filter">
          <label class="search">
            <span class="visually-hidden">{writing.searchLabel}</span>
            <input
              id="essay-search"
              type="search"
              placeholder={writing.searchLabel}
              autocomplete="off"
              spellcheck="false"
            />
          </label>
          <PostList posts={posts} />
          <p id="essay-empty" class="search-empty" hidden>{writing.searchEmpty}</p>
        </div>
      ) : (
        <p class="lead">
          {writing.empty}{" "}
          <a href={writing.subscribeHref} rel="noopener noreferrer">
            Paragraph
          </a>
        </p>
      )
    }

    <p class="source">
      Source: <a href={essaysFile.source.href} rel="noopener noreferrer">{essaysFile.source.label}</a>.
      The rest of the weekly essays live on{" "}
      <a href={essaysFile.archiveHref} rel="noopener noreferrer">Paragraph</a>.
    </p>
  </main>
</Base>

<style>
  .visually-hidden {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    width: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
  }
</style>

<script>
  const root = document.querySelector(".essay-filter");
  const input = document.querySelector<HTMLInputElement>("#essay-search");
  const empty = document.querySelector<HTMLElement>("#essay-empty");
  if (root && input) {
    const items = [...root.querySelectorAll<HTMLElement>("li")];
    const filter = () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      for (const item of items) {
        const hay = (item.dataset.search ?? "").toLowerCase();
        const show = !query || hay.includes(query);
        item.hidden = !show;
        if (show) visible += 1;
      }
      if (empty) empty.hidden = visible > 0;
    };
    input.addEventListener("input", filter);
  }
</script>
